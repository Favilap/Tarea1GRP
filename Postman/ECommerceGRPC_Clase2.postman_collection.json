        {
          "name": "Crear producto con token de Admin",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/productos",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "v1",
                "productos"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{nombreTarea1}}\",\n  \"descripcion\": \"Creado desde la Tarea 1\",\n  \"precio\": 49.9,\n  \"stock\": 10,\n  \"categoria\": \"Accesorios\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Nombre único en cada corrida: si se repite, CreateProduct responde AlreadyExists (409).",
                  "pm.collectionVariables.set(\"nombreTarea1\", \"Producto Tarea 1 \" + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"201\", () => pm.response.to.have.status(201));",
                  "const j = pm.response.json();",
                  "pm.test(\"Location apunta al GET por id\", () => pm.expect(pm.response.headers.get(\"Location\")).to.include(`/api/v1/productos/${j.id}`));",
                  "pm.test(\"precio decimal con 2 decimales\", () => pm.expect(j.precio).to.eql(49.9));",
                  "pm.collectionVariables.set(\"idProductoTarea1\", j.id);"
                ]
              }
            }
          ]
        },
